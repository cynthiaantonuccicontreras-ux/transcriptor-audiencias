OPENAI_API_KEY=sk-reemplaza-esta-linea
PORT=3000

# Se conserva Whisper porque es el modelo solicitado.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Código ISO-639-1. "es" mejora precisión y latencia para audiencias en español.
TRANSCRIPTION_LANGUAGE=es

# Cada bloque se convierte a MP3 mono de 48 kbps. Diez minutos pesan aprox. 3,6 MB.
CHUNK_DURATION_SECONDS=600
MAX_CHUNK_BYTES=24000000
MAX_UPLOAD_BYTES=2000000000
