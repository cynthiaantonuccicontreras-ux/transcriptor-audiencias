# Transcripción local gratuita: no se necesita clave ni saldo de API.
PORT=3000
HOST=127.0.0.1
TRANSCRIPTION_LANGUAGE=es
LOCAL_CHUNK_SECONDS=120
WHISPER_THREADS=2
WHISPER_CHUNK_TIMEOUT_MS=3600000
MAX_CHUNK_BYTES=24000000
MAX_UPLOAD_BYTES=2000000000

# Opcionales. Por defecto se usan los archivos de local-runtime/ del proyecto.
# WHISPER_CPP_BIN=/ruta/absoluta/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/ruta/absoluta/ggml-base-q5_1.bin
